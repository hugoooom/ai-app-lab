# 复制这个文件为 .env，然后填入自己的 key
# .env 已经在 .gitignore 里，不会被提交
#
# 常见服务商（都兼容 OpenAI 接口，模型名以各家控制台为准）：
#   智谱       base_url=https://open.bigmodel.cn/api/paas/v4      model=glm-4-flash
#   硅基流动   base_url=https://api.siliconflow.cn/v1             model=Qwen/Qwen2.5-7B-Instruct
#   DeepSeek   base_url=https://api.deepseek.com                 model=deepseek-chat

LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
